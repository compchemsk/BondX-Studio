C       0.000000     0.000000     3.087655
H       0.000000     1.030172     3.424244
H       0.892155    -0.515086     3.424244
H      -0.892155    -0.515086     3.424244
F       0.000000     0.000000    -2.439388
C       0.000000     0.000000    -3.715682
C       0.000000     0.000000    -4.904201
H       0.000000     0.000000    -5.965896
